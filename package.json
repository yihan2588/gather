{
  "name": "lvaep-session-reporting",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:demo": "LOCAL_DEMO=1 next dev --webpack",
